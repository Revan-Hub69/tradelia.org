#!/usr/bin/env sh
. "$(dirname "$0")/_/husky.sh"

# Run lint-staged for staged files
npx lint-staged

# Generate tokens if tokens.json changed (cross-platform check)
if git diff --cached --name-only | grep -q "design-tokens/tokens.json" 2>/dev/null || git diff --cached --name-only | findstr /C:"design-tokens/tokens.json" >nul 2>&1; then
  npm run generate-tokens
  git add design-tokens/tokens.css
fi
