{
  "root": true,
  "env": {
    "browser": true,
    "es2024": true,
    "node": true,
    "webextensions": false
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "prettier"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": [
    "@typescript-eslint",
    "prettier"
  ],
  "rules": {
    "prettier/prettier": "error",
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/explicit-module-boundary-types": "off",
    "@typescript-eslint/no-explicit-any": "warn",
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ],
    "prefer-const": "error",
    "no-var": "error",
    "eqeqeq": ["error", "always"],
    "curly": ["error", "all"]
  },
  "overrides": [
    {
      "files": ["*.js"],
      "parser": "espree",
      "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
      },
      "env": {
        "node": true,
        "browser": true
      },
      "rules": {
        "@typescript-eslint/no-var-requires": "off",
        "@typescript-eslint/explicit-function-return-type": "off",
        "no-console": "off"
      }
    },
    {
      "files": ["assets/js/**/*.js", "assets/js/**/*.ts"],
      "parser": "espree",
      "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
      },
      "env": {
        "browser": true,
        "node": false,
        "es2024": true
      },
      "globals": {
        "window": "readonly",
        "document": "readonly",
        "localStorage": "readonly",
        "fetch": "readonly",
        "confirm": "readonly",
        "alert": "readonly",
        "setTimeout": "readonly",
        "clearTimeout": "readonly"
      },
      "rules": {
        "no-console": ["warn", { "allow": ["warn", "error"] }],
        "@typescript-eslint/no-var-requires": "off"
      }
    },
    {
      "files": ["api/**/*.js"],
      "parser": "espree",
      "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
      },
      "env": {
        "node": true,
        "browser": false,
        "es2024": true
      },
      "globals": {
        "console": "readonly"
      },
      "rules": {
        "no-console": ["warn", { "allow": ["warn", "error"] }],
        "@typescript-eslint/no-var-requires": "off"
      }
    },
    {
      "files": ["scripts/**/*.js"],
      "env": {
        "node": true
      },
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["*.ts"],
      "parserOptions": {
        "project": "./tsconfig.json"
      }
    },
    {
      "files": ["tests/**/*.js", "vitest.config.js"],
      "parser": "espree",
      "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
      },
      "env": {
        "node": true,
        "browser": true
      },
      "rules": {
        "@typescript-eslint/no-var-requires": "off",
        "@typescript-eslint/explicit-function-return-type": "off",
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "build/",
    "*.min.js",
    "archivio/",
    "swing-master-5.0/",
    "report/",
    "docs/",
    ".git/"
  ]
}

