generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Assessment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  markets               String
  horizon               String
  frequencyPerWeek      Int
  orderTypes            String
  typicalNotionalBucket String
  slippageTolerance     String
  regulatoryPreference  String
  needsApi              Boolean @default(false)
  baseCurrency          String
  currentProviders      String

  result AssessmentResult?

  @@map("assessments")
}

model AssessmentResult {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  assessmentId String   @unique
  perDomain    String
  overall      String
  audit        String

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("assessment_results")
}

model Provider {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  name        String   @unique
  type        String
  regions     String
  regulatedIn String
  products    String

  website     String?
  description String?

  feeSchedules FeeSchedule[]

  @@map("providers")
}

model FeeSchedule {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  product    String
  instrument String?

  makerFeePct        Float?
  takerFeePct        Float?
  commissionPerTrade Float?
  minCommission      Float?
  maxCommission      Float?
  fxFeePct           Float?

  financingRatePolicy String?
  spreadPolicy        String  @default("variable")

  withdrawalFees String?

  sourceUrl      String?
  lastVerifiedAt DateTime?
  notes          String?

  @@unique([providerId, product, instrument])
  @@map("fee_schedules")
}
