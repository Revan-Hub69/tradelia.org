generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  // Explicitly disable Accelerate extension
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
}

model Session {
  id               String   @id @default(cuid())
  mode             String   // DEMO_STRESS|DEMO_REALISTIC|LIVE_MICRO|LIVE_SCALE
  screenerProfile  String   // A|B
  executionMode    String   // confirm|auto
  binanceEnv       String   // testnet|live
  status           String   // RUNNING|STOPPED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  tradePlans       TradePlan[]
  jobs             Job[]
  
  @@map("sessions")
}

model TradePlan {
  id              String   @id @default(cuid())
  sessionId       String
  env             String   // testnet|live
  mode            String
  screenerProfile String   // A|B
  symbol          String
  side            String   // LONG|SHORT
  entry           Json     // {type, price}
  risk            Json     // {sl, tp1, tp2, trail}
  sizing          Json     // {qty, leverage, marginType}
  gates           Json     // {setup_pass, micro_pass, funding_mode, expires_at}
  why             Json     // array of reasons
  metrics         Json     // {obi5, obi20, delta_fast, delta_slow, spread, atrp15m, funding}
  status          String   @default("PENDING") // PENDING|EXECUTED|EXPIRED|CANCELLED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  session         Session  @relation(fields: [sessionId], references: [id])
  orders          Order[]
  
  @@map("trade_plans")
}

model Job {
  id          String   @id @default(cuid())
  sessionId   String
  planId      String?
  requestId   String   @unique
  type        String   // EXECUTE_PLAN|MONITOR_POSITION|UPDATE_MARKET_DATA
  payload     Json
  status      String   @default("PENDING") // PENDING|PROCESSING|COMPLETED|FAILED
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  session     Session  @relation(fields: [sessionId], references: [id])
  
  @@map("jobs")
}

model Order {
  id              String   @id @default(cuid())
  planId          String
  clientOrderId   String   @unique
  binanceOrderId  String?
  symbol          String
  side            String   // BUY|SELL
  type            String   // MARKET|LIMIT|STOP_MARKET
  quantity        String
  price           String?
  stopPrice       String?
  status          String   // NEW|FILLED|CANCELLED|REJECTED
  fills           Json?    // array of fill objects
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  tradePlan       TradePlan @relation(fields: [planId], references: [id])
  
  @@map("orders")
}

model Position {
  id              String   @id @default(cuid())
  symbol          String   @unique
  side            String   // LONG|SHORT|FLAT
  size            String
  entryPrice      String?
  markPrice       String?
  unrealizedPnl   String?
  marginType      String   // ISOLATED|CROSS
  leverage        String
  status          String   // FLAT|PENDING|OPEN|EXITING
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@map("positions")
}

model MarketData {
  id          String   @id @default(cuid())
  symbol      String
  type        String   // KLINE|DEPTH|FUNDING|TICKER
  data        Json
  timestamp   DateTime
  createdAt   DateTime @default(now())
  
  @@index([symbol, type, timestamp])
  @@map("market_data")
}

model FeatureSnapshot {
  snapshotId  String   @id @default(uuid()) @map("snapshot_id")
  exchange    String   @default("binance")
  venue       String   @default("futures_usdt")
  symbol      String
  ts          DateTime
  features    Json
  quality     Json
  sourceMeta  Json     @default("{}") @map("source_meta")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([symbol, ts])
  @@map("feature_snapshots")
}

// OMS + Risk Engine Models
model RiskState {
  id                    Int      @id @default(1)
  env                   String   @unique
  tradingEnabled        Boolean  @default(false)
  killActive            Boolean  @default(false)
  killReason            String?
  dailyLossUsed         Float    @default(0.0)  // USD
  dailyLossLimitPct     Float    @default(1.5)  // %
  maxPositions          Int      @default(2)
  cooldownUntilTs       DateTime?
  circuitOpenUntilTs    DateTime?
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  @@map("risk_states")
}

model OrderRecord {
  id              String   @id @default(cuid())
  ts              DateTime @default(now())
  env             String
  symbol          String
  planId          String
  leg             String   // ENTRY|SL|TP1|TP2|FLAT|EMERGENCY_SL
  seq             Int
  clientOrderId   String   @unique
  side            String   // BUY|SELL
  type            String   // MARKET|LIMIT|STOP_MARKET|TAKE_PROFIT_MARKET
  quantity        String
  price           String?
  stopPrice       String?
  reduceOnly      Boolean  @default(false)
  timeInForce     String?  // GTC|IOC|FOK
  positionSide    String?  // LONG|SHORT (only for hedge mode)
  status          String   @default("PENDING") // PENDING|PLACED|FILLED|CANCELED|REJECTED
  exchangeOrderId String?
  lastError       String?
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@map("order_records")
}

model PositionRecord {
  id                String   @id @default(cuid())
  ts                DateTime @default(now())
  env               String
  symbol            String
  side              String   // LONG|SHORT
  quantity          String
  entryPrice        String?
  unrealizedPnl     String?
  realizedPnl       String   @default("0")
  slClientOrderId   String?
  tpClientOrderIds  Json     @default("[]")  // array of strings
  positionSide      String?  // LONG|SHORT (only for hedge mode)
  status            String   @default("OPEN") // OPEN|CLOSED
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  @@map("position_records")
}

model KillEvent {
  id          String   @id @default(cuid())
  ts          DateTime @default(now())
  env         String
  reason      String   // ERROR_STORM|RATE_LIMIT|WS_LAG|BOOK_GAP|MARK_DISLOCATION|MANUAL
  details     Json     @default("{}")

  @@map("kill_events")
}

model ReconcileEvent {
  id          String   @id @default(cuid())
  ts          DateTime @default(now())
  env         String
  symbol      String
  action      String   // SL_PLACED|ORDER_CANCELED|POSITION_FLATTENED|STATE_UPDATED
  details     Json     @default("{}")

  @@map("reconcile_events")
}

model TrackedSymbol {
  id          String   @id @default(cuid())
  env         String
  symbol      String
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([env, symbol])
  @@map("tracked_symbols")
}

// Screener models
model ScreenerRun {
  id          String   @id @default(cuid())
  ts          DateTime @default(now())
  env         String
  topK        Json     // array of {symbol, score, rank}
  summary     Json     // {totalCandidates, vetted, topKCount, wsHealth}
  wsHealth    Json     // {lagMs, gapMs, degraded: boolean}
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("screener_runs")
}

model SymbolScore {
  id          String   @id @default(cuid())
  ts          DateTime @default(now())
  env         String
  symbol      String
  lqs         Float    // Liquidity Quality Score (0-100)
  vos         Float    // Volatility Opportunity Score (0-100)
  dfs         Float    // Derivatives Flow Score (0-100)
  mes         Float    // Microstructure Edge Score (0-100)
  mtfGate     String   // PASS|REVIEW|FAIL
  totalScore  Float    // weighted total (0-100)
  vetoed      Boolean  @default(false)
  reasons     Json     // array of reason codes
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([env, symbol, ts])
  @@map("symbol_scores")
}

model ScreenerConfig {
  id                    Int      @id @default(1)
  env                   String   @unique
  screenerEnabled       Boolean  @default(true)
  topK                  Int      @default(20)
  refreshSec            Int      @default(60)
  maxSymbolsTracked     Int      @default(60)
  universeMode          String   @default("auto") // auto|static
  staticSymbols         String?  // comma-separated if mode=static
  marketDataEnv         String   @default("live")
  mtfTfList             String   @default("1m,5m,15m")
  minDailyQuoteVolUsd   Float    @default(50000000)
  maxSpreadBps          Float    @default(12)
  minDepthUsdTopN       Float    @default(200000)
  orderbookLevels       Int      @default(50)
  wsLagWarnMs           Int      @default(800)
  wsLagFailMs           Int      @default(1500)
  bookGapFailMs         Int      @default(2000)
  thresholds            Json     @default("{}") // additional scoring thresholds
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  @@map("screener_configs")
}
