generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Assessment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  markets               Json
  horizon               String
  frequencyPerWeek      Int
  orderTypes            Json
  typicalNotionalBucket String
  slippageTolerance     String
  regulatoryPreference  String
  needsApi              Boolean @default(false)
  baseCurrency          String
  currentProviders      Json

  result AssessmentResult?

  @@map("assessments")
}

model AssessmentResult {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  assessmentId String   @unique
  perDomain    Json
  overall      Json
  audit        Json

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("assessment_results")
}

model Provider {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  name        String   @unique
  type        String
  regions     Json
  regulatedIn Json
  products    Json

  website     String?
  description String?

  feeSchedules FeeSchedule[]

  @@map("providers")
}

model FeeSchedule {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  product    String
  instrument String?

  makerFeePct        Float?
  takerFeePct        Float?
  commissionPerTrade Float?
  minCommission      Float?
  maxCommission      Float?
  fxFeePct           Float?

  financingRatePolicy String?
  spreadPolicy        String  @default("variable")

  withdrawalFees Json?

  sourceUrl      String?
  lastVerifiedAt DateTime?
  notes          String?

  @@unique([providerId, product, instrument])
  @@map("fee_schedules")
}
