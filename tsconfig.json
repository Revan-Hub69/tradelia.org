{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "node",
    "rootDir": "./",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "incremental": true,
    "types": ["node"]
  },
  "include": [
    "assets/js/**/*",
    "scripts/**/*",
    "api/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "archivio",
    "swing-master-5.0",
    "report",
    "docs",
    "*.min.js"
  ]
}
