{
  "name": "@tradelia/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:prod": "pnpm run migrate:deploy && node dist/index.js",
    "migrate:deploy": "prisma migrate deploy --schema=../../prisma/schema.prisma",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:setup": "tsx scripts/setup-db.ts",
    "db:migrate": "prisma migrate deploy --schema=../../prisma/schema.prisma",
    "db:generate": "prisma generate --schema=../../prisma/schema.prisma",
    "db:seed": "tsx scripts/seed.ts",
    "prisma:generate": "prisma generate --schema=../../prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema=../../prisma/schema.prisma",
    "postinstall": "pnpm run prisma:generate"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@prisma/adapter-pg": "^6.1.0",
    "@prisma/client": "7.2.0",
    "@supabase/supabase-js": "2.89.0",
    "@tradelia/shared": "workspace:*",
    "axios": "^1.7.9",
    "dotenv": "17.2.3",
    "fastify": "5.6.2",
    "pg": "^8.13.0",
    "pino": "^9.14.0",
    "ws": "^8.18.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "@types/pg": "^8.10.0",
    "@types/ws": "^8.5.13",
    "prisma": "7.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
