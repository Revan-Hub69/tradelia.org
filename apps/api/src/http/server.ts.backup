        tradingEnabled: env.TRADING_ENABLED,
        trackedSymbols: env.TRACK_SYMBOLS.split(',').map(s => s.trim()),
        serverTime: new Date().toISOString(),
        version: '1.1.0',
        mode: this.prisma ? 'full' : 'demo'
