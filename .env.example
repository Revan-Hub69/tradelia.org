# ============================================
# TRADELIA - Environment Variables Template
# ============================================
# 
# Copia questo file come .env.local e aggiungi le tue API keys
# cp .env.example .env.local
#
# Tutte le API keys sono GRATIS - nessun costo
# ============================================

# ============================================
# FRED API (Federal Reserve)
# ============================================
# Obbligatorio per: Economic Indicators, Bond Yields
# Ottieni qui: https://fred.stlouisfed.org/docs/api/api_key.html
# Rate Limit: Illimitato (gratis)
FRED_API_KEY=your_fred_api_key_here

# ============================================
# Finnhub API
# ============================================
# Obbligatorio per: Stock Market Indexes, Forex Major Pairs
# Ottieni qui: https://finnhub.io/register
# Rate Limit: 60 calls/min (free tier)
FINNHUB_API_KEY=your_finnhub_api_key_here

# ============================================
# Alpha Vantage API
# ============================================
# Obbligatorio per: Commodities (Gold, Oil, Silver)
# Ottieni qui: https://www.alphavantage.co/support/#api-key
# Rate Limit: 5 calls/min, 500 calls/day (free tier)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# ============================================
# Groq API
# ============================================
# Obbligatorio per: Lettura AI di tutti gli indicatori
# Ottieni qui: https://console.groq.com/
# Rate Limit: Generoso (free tier)
GROQ_API_KEY=your_groq_api_key_here

# ============================================
# API Senza Key (Già Funzionanti)
# ============================================
# - CoinGecko (Bitcoin Dominance, Crypto Market Cap)
# - Alternative.me (Fear & Greed Crypto)
# - Yahoo Finance (VIX)
# ============================================
