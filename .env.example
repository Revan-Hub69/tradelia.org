# ---------------------------
# CRITICAL ENVIRONMENT VARIABLES
# ---------------------------
# These are REQUIRED for the system to work. Copy this file to .env and fill in the values.

# ---------------------------
# EXCHANGE CONFIGURATION (REQUIRED)
# ---------------------------
# Exchange environment: 'testnet' for testing, 'live' for real trading
EXCHANGE_ENV=testnet

# Binance API credentials (get from https://binance.com)
# For testnet: https://testnet.binance.vision/
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# ---------------------------
# DATABASE (REQUIRED)
# ---------------------------
# Supabase connection string (Settings -> Database -> Connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# Direct connection (recommended for Prisma on some platforms)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# ---------------------------
# SUPABASE AUTH (REQUIRED for web app)
# ---------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ---------------------------
# SYMBOL TRACKING (REQUIRED)
# ---------------------------
# Comma-separated list of symbols to track initially
TRACK_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT

# ---------------------------
# SERVER CONFIGURATION
# ---------------------------
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------
# CORS CONFIGURATION (REQUIRED for production)
# ---------------------------
# For Railway production deployment
CORS_ORIGIN=https://your-frontend-domain.vercel.app

# ---------------------------
# TRADING CONFIGURATION
# ---------------------------
# Trading mode: 'oneway' or 'hedge'
POSITION_MODE=oneway

# Master trading switch
TRADING_ENABLED=false

# Risk management
MAX_CONCURRENT_POSITIONS=2
DAILY_MAX_LOSS_PCT=1.5

# Emergency stop loss (basis points)
EMERGENCY_SL_BPS=80

# ---------------------------
# SCREENER CONFIGURATION
# ---------------------------
SCREENER_ENABLED=true
SCREENER_TOP_K=20
SCREENER_REFRESH_SEC=60
MAX_SYMBOLS_TRACKED=60

# Screener mode: 'auto' (dynamic) or 'static' (fixed symbols)
SCREEN_UNIVERSE_MODE=auto

# Static symbols if using static mode
STATIC_SYMBOLS=BTCUSDT,ETHUSDT

# ---------------------------
# MARKET DATA CONFIGURATION
# ---------------------------
MARKET_DATA_ENV=live
MTF_TF_LIST=1m,5m,15m

# Minimum daily quote volume (USD)
MIN_DAILY_QUOTE_VOL_USD=50000000

# Maximum spread tolerance (basis points)
MAX_SPREAD_BPS=12

# Minimum order book depth (USD)
MIN_DEPTH_USD_TOPN=200000

# Order book levels to track
ORDERBOOK_LEVELS=50

# WebSocket lag thresholds (ms)
WS_LAG_WARN_MS=800
WS_LAG_FAIL_MS=1500
BOOK_GAP_FAIL_MS=2000

# ---------------------------
# ERROR HANDLING
# ---------------------------
ERROR_STORM_FAIL=8
COOLDOWN_AFTER_LOSS_MIN=15

# ---------------------------
# BINANCE TIMEOUTS & RETRIES
# ---------------------------
BINANCE_REST_TIMEOUT_MS=4000
BINANCE_RETRY_MAX=3
BINANCE_RETRY_BASE_MS=250
BINANCE_CB_OPEN_SEC=30

# ---------------------------
# RATE LIMITING
# ---------------------------
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ---------------------------
# OPERATIONAL MODE (from OPERATIONAL-SPEC.md)
# ---------------------------
# Trading mode with different risk limits: testnet, micro_live, full_live
MODE=testnet

# Risk per trade percentage
RISK_PER_TRADE_PCT=0.25

# Risk management per mode (see OPERATIONAL-SPEC.md table)
# MODE=testnet: MAX_LEVERAGE_DEFAULT=5, MAX_LEVERAGE_STRESS=2
# MODE=micro_live: MAX_LEVERAGE_DEFAULT=3, MAX_LEVERAGE_STRESS=2
# MODE=full_live: MAX_LEVERAGE_DEFAULT=5-8, MAX_LEVERAGE_STRESS=2
MAX_LEVERAGE_DEFAULT=5
MAX_LEVERAGE_STRESS=2

# Quality gates / Kill thresholds (from OPERATIONAL-SPEC.md)
SPREAD_MULT_FAIL=3.0
MARK_INDEX_FAIL_BPS=30

# ---------------------------
# DEPLOYMENT URLs (REQUIRED for Vercel/Railway)
# ---------------------------
# Internal API URL for Railway (used by web app in production)
API_INTERNAL_URL=https://your-api-service.railway.app

# External API URL for Vercel (used by web app in development)
API_URL=https://your-api-service.railway.app

# Supabase client configuration (for Next.js client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ---------------------------
# EMAIL SERVICE (OPTIONAL)
# ---------------------------
# Brevo API key for email notifications
BREVO_API_KEY=your_brevo_api_key_here

# ---------------------------
# ADVANCED FEATURES
# ---------------------------
ENABLE_INCOME_TRACKING=false
TRUST_PROXY=false
