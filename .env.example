# ============================================
# TRADELIA - Environment Variables Template
# ============================================
# 
# Copia questo file come .env.local e aggiungi le tue API keys
# cp .env.example .env.local
#
# Tutte le API keys sono GRATIS - nessun costo (tranne Twilio)
# ============================================

# ============================================
# 🔴 OBBLIGATORIE (7) - L'app non funziona senza
# ============================================

# ============================================
# Supabase Configuration (CRITICHE)
# ============================================
# Ottieni qui: https://supabase.com/dashboard → Project Settings → API
# Costo: GRATIS
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ============================================
# FRED API (Federal Reserve)
# ============================================
# Obbligatorio per: Economic Indicators, Bond Yields, Yield Curve, Credit Spreads, Leading Indicators, Business Cycle, Financial Stress, PMI (USA), DXY, Real Estate
# Ottieni qui: https://fred.stlouisfed.org/docs/api/api_key.html
# Rate Limit: 120 calls/min, illimitato giornaliero (GRATIS)
FRED_API_KEY=your_fred_api_key_here

# ============================================
# Finnhub API
# ============================================
# Obbligatorio per: Stock Indexes, Market Breadth, McClellan, TRIN, European/Asian/Emerging Indexes, Stocks Globali, Forex, ETF, VWAP, OBV, A/D, MFI, Chaikin, EOM, Short Interest, IPO Calendar, Corporate Events, Economic Calendar
# Ottieni qui: https://finnhub.io/register
# Rate Limit: 60 calls/min (free tier)
FINNHUB_API_KEY=your_finnhub_api_key_here

# ============================================
# Alpha Vantage API
# ============================================
# Obbligatorio per: Commodities (Gold, Oil, Silver), Commodity Rotation
# Ottieni qui: https://www.alphavantage.co/support/#api-key
# Rate Limit: 5 calls/min, 500 calls/day (free tier)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# ============================================
# Groq API
# ============================================
# Obbligatorio per: AI Readings per TUTTI gli indicatori
# Ottieni qui: https://console.groq.com/
# Rate Limit: 30 requests/min (free tier)
GROQ_API_KEY=your_groq_api_key_here

# ============================================
# 🟡 CONSIGLIATE (6) - Funzionalità importanti
# ============================================

# ============================================
# Brevo (ex SendinBlue) - Email Service
# ============================================
# Consigliato per: Invio email (notifiche, password reset, checkout)
# Ottieni qui: https://www.brevo.com/ → Settings → API Keys
# Costo: GRATIS (300 email/giorno)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_EMAIL=noreply@tradelia.org
BREVO_FROM_NAME=Tradelia

# ============================================
# App Configuration
# ============================================
# URL base dell'applicazione (per link email, redirect, cron jobs)
# Esempio: https://tradelia.org o https://app.tradelia.org
NEXT_PUBLIC_APP_URL=https://tradelia.org

# ============================================
# Security Keys
# ============================================
# Genera con: openssl rand -hex 32
# Protezione endpoint migrazioni Supabase
MIGRATION_SECRET_KEY=your_migration_secret_key_here
# Autenticazione cron jobs
CRON_SECRET=your_cron_secret_key_here

# ============================================
# 🟢 OPZIONALI - Crypto Analytics (3)
# ============================================
# Hanno fallback a mock data se non configurati

# ============================================
# Whale Alert API
# ============================================
# Opzionale per: Whale Analysis (transazioni whale crypto)
# Ottieni qui: https://whale-alert.io/ → API → Get API Key
# Rate Limit: 100 calls/day (free tier)
# Status: ⚠️ OPZIONALE - Ha fallback a mock data
WHALE_ALERT_API_KEY=your_whale_alert_api_key_here

# ============================================
# Santiment API
# ============================================
# Opzionale per: Social Sentiment (crypto), Market Sentiment
# Ottieni qui: https://santiment.net/ → API → Get API Key
# Rate Limit: 100 calls/day (free tier)
# Status: ⚠️ OPZIONALE - Ha fallback a Reddit
SANTIMENT_API_KEY=your_santiment_api_key_here

# ============================================
# Glassnode API
# ============================================
# Opzionale per: Exchange Flows (crypto)
# Ottieni qui: https://glassnode.com/ → API → Get API Key
# Rate Limit: 1 call/sec (free tier)
# Status: ⚠️ OPZIONALE - Ha fallback a mock data
GLASSNODE_API_KEY=your_glassnode_api_key_here

# ============================================
# 🟢 OPZIONALI - Push Notifications (3) - Oslo
# ============================================
# Genera con: npx web-push generate-vapid-keys
# Push notifications non funzionano senza queste

NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:support@tradelia.org

# ============================================
# 🟢 OPZIONALI - SMS/WhatsApp (4) - 💰 A PAGAMENTO
# ============================================
# Twilio - SMS/WhatsApp notifications
# Ottieni qui: https://www.twilio.com/
# Costo: 💰 A PAGAMENTO (non free tier)
# Status: ⚠️ OPZIONALE - SMS/WhatsApp non funzionano senza

TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ============================================
# 🟢 OPZIONALI - Economic Calendar (2)
# ============================================
# Trading Economics - Economic Calendar globale
# Ottieni qui: https://tradingeconomics.com/api → Register
# Rate Limit: 2 calls/min (free tier)
# Status: ⚠️ OPZIONALE - Ha fallback se non configurato

TRADING_ECONOMICS_CLIENT_KEY=your_trading_economics_client_key_here
TRADING_ECONOMICS_CLIENT_SECRET=your_trading_economics_client_secret_here

# ============================================
# 🟢 OPZIONALI - Options Flow (2)
# ============================================
# Solo per Options Flow (indicatore PRO)

# Polygon.io
# Ottieni qui: https://polygon.io/ → Register → API Keys
# Rate Limit: 5 calls/min (free tier)
POLYGON_API_KEY=your_polygon_api_key_here

# IEX Cloud (alternativa a Polygon.io)
# Ottieni qui: https://iexcloud.io/ → Register → API Tokens
# Rate Limit: 50,000 messages/mese (free tier)
IEX_CLOUD_API_KEY=your_iex_cloud_api_key_here

# ============================================
# 🟢 OPZIONALI - Financial Modeling Prep (FMP) (1)
# ============================================
# Utile per: Short Interest, Insider Trading, IPO Calendar Avanzato
# Ottieni qui: https://site.financialmodelingprep.com/developer/docs/
# Rate Limit: 250 calls/day (free tier)
# Status: ⚠️ OPZIONALE - Alternativa a Finnhub/SEC per Short Interest e Insider Trading
FMP_API_KEY=your_fmp_api_key_here

# ============================================
# 🟢 OPZIONALI - Twelve Data (1)
# ============================================
# Utile per: Technical Indicators Pre-calcolati, Historical Data
# Ottieni qui: https://twelvedata.com/ → API Keys
# Rate Limit: 800 calls/day (free tier)
# Status: ⚠️ OPZIONALE - Risparmia calcoli per indicatori tecnici
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# ============================================
# 🟢 OPZIONALI - Analytics & Monitoring (3)
# ============================================

# Google Analytics
# Ottieni qui: https://analytics.google.com/ → Create Property
# Formato: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry - Error Tracking
# Ottieni qui: https://sentry.io/ → Create Project
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# Admin Email
# Email admin per notifiche
ADMIN_EMAIL=admin@tradelia.org

# ============================================
# 🟢 OPZIONALI - Payment/Checkout (2)
# ============================================
# Xolo Go - Payment integration

NEXT_PUBLIC_XOLO_PAYMENT_LINK=https://pay.xolo.io
NEXT_PUBLIC_XOLO_IBAN=your_xolo_iban_here

# ============================================
# API Senza Key (Già Funzionanti)
# ============================================
# Queste NON richiedono API key:
# - CoinGecko (Bitcoin Dominance, Crypto Market Cap, Top Movers, Trending, Whale Analysis, Social Sentiment, Developer Activity, NVT, MVRV, Active Addresses)
# - Binance Public API (L400 Depth, Aggregated Depth, Multi-Exchange Depth, Top 400 Monitor, Order Flow, Delta, Volume Profile, Time & Sales, Heatmap, Spread, Large Orders, Imbalance Zones)
# - Coinbase Public API (Aggregated Depth, Multi-Exchange Depth, Heatmap, Spread, Large Orders, Imbalance Zones)
# - Yahoo Finance (VIX, VIX Term Structure, Put/Call Ratio, Volatility Composite, DXY, Futures Term Structure)
# - Alternative.me (Fear & Greed Index)
# - CFTC (COT Reports)
# - ECB, Eurostat, World Bank, IMF (Economic Indicators Globali)
# - SEC EDGAR (IPO data, Insider Trading)
# ============================================
