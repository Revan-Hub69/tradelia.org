# ---------------------------
# Supabase (DB Postgres)
# ---------------------------
# Usa la stringa "Connection string" in Supabase (Settings -> Database)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# Se usi anche DIRECT_URL (consigliato per Prisma su alcune piattaforme)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# ---------------------------
# API
# ---------------------------
API_PORT=4000
NODE_ENV=development

# CORS (es. dominio vercel)
CORS_ORIGIN="https://tradelia.org"
