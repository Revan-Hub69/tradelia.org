# Environment
APP_ENV=dev
NODE_ENV=development

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/tradelia_db"

# Binance Configuration
BINANCE_ENV=testnet
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_secret_here

# Feature Flags
FEATURE_WS_MARKET=true
FEATURE_OI=false
FEATURE_USER_STREAM=false
FEATURE_WS_EXECUTION=false

# Execution Settings
MICRO_MODE=ws_mixed
EXECUTION_MODE=confirm

# API Configuration
PORT=3001
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Web App
API_URL=http://localhost:3001