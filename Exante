    <script>
      document.addEventListener("DOMContentLoaded", function () {
        setTimeout(() => {
          document.getElementById("cookie-popup").style.display = "flex";
        }, 1000);

        const form = document.querySelector("form");
        form.addEventListener("submit", function (e) {
          const requiredFields = ["asset", "categoria", "timeframe", "focus", "nome", "contatto", "metodo"];
          let valid = true;
          requiredFields.forEach(id => {
            const field = document.getElementById(id);
            const label = document.querySelector(`label[for='${id}']`);
            if (!field.value) {
              valid = false;
              label.innerHTML = label.innerHTML.replace(/✅/g, '').replace(/<span.*?<\/span>/, '<span class="text-red-500">*</span>');
            } else {
              label.innerHTML = label.innerHTML.replace(/<span.*?<\/span>/, '✅');
            }
          });
          if (!valid) {
            e.preventDefault();
            alert("Compila tutti i campi obbligatori contrassegnati con *");
          } else {
            setTimeout(() => {
              document.getElementById("form-response").classList.remove("hidden");
            }, 300);
          }
        });

        const phrases = [
          "AI per trader moderni",
          "Strumenti gratuiti, zero fuffa",
          "Operatività solo in ambiente demo"
        ];
        let current = 0;
        const typingElement = document.getElementById("typing-text");

        function typePhrase() {
          const phrase = phrases[current];
          typingElement.textContent = "";
          [...phrase].forEach((char, i) => {
            setTimeout(() => {
              typingElement.textContent += char;
            }, i * 50);
          });
          setTimeout(() => {
            current = (current + 1) % phrases.length;
            typePhrase();
          }, phrase.length * 50 + 2000);
        }
        typePhrase();
      });

      function apriSezioneLegale(id) {
        const modal = document.createElement("div");
        modal.className = "modal animate-fade-in";
        modal.style.display = "flex";
        modal.innerHTML = `
          <div class="modal-content">
            <div class="modal-close hover:text-red-500 transition" onclick="this.parentElement.parentElement.remove()">✕</div>
            <h3 class="text-lg font-semibold mb-2">${id === 'section-tc' ? 'Termini e Condizioni' : 'Privacy Policy'}</h3>
            <p class="text-sm text-gray-800">${id === 'section-tc' ? 'Questo progetto è destinato solo a scopo educativo. Nessuna consulenza, nessun invito all\'investimento. Tutte le operazioni simulate in ambiente demo.' : 'Tradelia non raccoglie dati personali, non utilizza cookie di profilazione e non traccia in alcun modo l\'utente. Progetto open per educazione finanziaria.'}</p>
          </div>`;
        document.body.appendChild(modal);
      }
    </script>
