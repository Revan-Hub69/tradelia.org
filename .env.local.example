# ============================================
# Supabase Configuration
# ============================================
# Copia questo file come .env.local e compila i valori
# .env.local è già in .gitignore (non verrà committato)

# URL del progetto Supabase
# Formato: https://<project-ref>.supabase.co
SUPABASE_URL=https://xxx.supabase.co

# Service Role Key (solo per metodo API)
# ⚠️ NON condividere mai questa chiave!
# Ottienila da: Supabase Dashboard → Settings → API → Service Role Key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Database Password (opzionale, solo per alcuni metodi)
# SUPABASE_DB_PASSWORD=your-db-password
